# Copy to .dev.vars for local Wrangler / Astro Cloudflare proxy development.
# Never commit real secrets.

DEMO_MODE=true
PUBLIC_SITE_URL=http://127.0.0.1:4321
PUBLIC_CASE_STUDY_URL=https://chexustudio.com/work/harbour-pine-home
PUBLIC_PACKAGES_URL=https://chexustudio.com/packages
PUBLIC_STUDIO_URL=https://chexustudio.com
ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321

# Cloudflare Turnstile (optional locally — use token "dev-bypass" when unset)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Stripe test mode (disabled unless explicitly configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# D1 is configured in wrangler.jsonc (replace database_id before production use)
