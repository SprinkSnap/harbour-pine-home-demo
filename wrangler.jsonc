{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "harbour-pine-home-demo",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harbour-pine-leads",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    "PUBLIC_SITE_URL": "https://harbourandpinehome.chexustudio.com",
    "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/harbour-pine-home",
    "PUBLIC_PACKAGES_URL": "https://chexustudio.com/packages",
    "PUBLIC_STUDIO_URL": "https://chexustudio.com",
    "ALLOWED_ORIGINS": "https://harbourandpinehome.chexustudio.com,http://localhost:4321,http://127.0.0.1:4321"
  },
  "env": {
    "staging": {
      "name": "harbour-pine-home-demo-staging",
      "vars": {
        "DEMO_MODE": "true",
        "PUBLIC_SITE_URL": "https://harbour-pine-home-demo-staging.workers.dev",
        "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/harbour-pine-home",
        "PUBLIC_PACKAGES_URL": "https://chexustudio.com/packages",
        "PUBLIC_STUDIO_URL": "https://chexustudio.com",
        "ALLOWED_ORIGINS": "https://harbour-pine-home-demo-staging.workers.dev,http://localhost:4321,http://127.0.0.1:4321"
      }
    }
  }
}
