{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "harbour-pine-home-demo",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Pin the SESSION KV created on the first CI deploy. Leaving this unbound makes
  // Wrangler try to recreate "harbour-pine-home-demo-session" and fail with API 10014.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "af67741f41f74c04a9f2f13a9b073a71"
    }
  ],
  // Omit database_id so Cloudflare Workers Builds can auto-provision D1 on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harbour-pine-leads",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    "PUBLIC_SITE_URL": "https://harbourandpinehome.chexustudio.com",
    "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/",
    "PUBLIC_PACKAGES_URL": "https://chexustudio.com/pricing/",
    "PUBLIC_STUDIO_URL": "https://chexustudio.com",
    "ALLOWED_ORIGINS": "https://harbourandpinehome.chexustudio.com,http://localhost:4321,http://127.0.0.1:4321"
  },
  "env": {
    "staging": {
      "name": "harbour-pine-home-demo-staging",
      "vars": {
        "DEMO_MODE": "true",
        "PUBLIC_SITE_URL": "https://harbour-pine-home-demo-staging.workers.dev",
        "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/",
        "PUBLIC_PACKAGES_URL": "https://chexustudio.com/pricing/",
        "PUBLIC_STUDIO_URL": "https://chexustudio.com",
        "ALLOWED_ORIGINS": "https://harbour-pine-home-demo-staging.workers.dev,http://localhost:4321,http://127.0.0.1:4321"
      }
    }
  }
}
