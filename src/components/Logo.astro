---
import { siteConfig } from '../data/site';
import LogoMark from './LogoMark.astro';

interface Props {
  class?: string;
  compact?: boolean;
  /** Use on dark surfaces such as the footer. */
  tone?: 'default' | 'on-dark';
  /** Optional larger lockup for hero brand moments. */
  size?: 'sm' | 'md' | 'lg' | 'responsive';
}
const { class: className = '', compact = false, tone = 'default', size = 'responsive' } = Astro.props;

const titleClass =
  size === 'lg'
    ? 'text-2xl sm:text-3xl'
    : size === 'sm'
      ? 'text-base'
      : 'text-base sm:text-[1.05rem] lg:text-lg';

const nameClass = tone === 'on-dark' ? 'text-sand group-hover:text-sand' : 'text-pine-dark group-hover:text-pine';
const taglineClass = tone === 'on-dark' ? 'text-sage' : 'text-harbour';
---

<a
  href="/"
  class:list={[
    'group inline-flex min-w-0 max-w-full items-center gap-2.5 no-underline transition duration-[var(--duration-fast)] sm:gap-3',
    className,
  ]}
  aria-label={`${siteConfig.name} home`}
  title={siteConfig.name}
>
  <LogoMark size={size} tone={tone} />
  {
    !compact && (
      <span class="min-w-0 leading-tight">
        <span class:list={['block whitespace-nowrap font-display tracking-[-0.02em]', titleClass, nameClass]}>
          <span class="lg:hidden">{siteConfig.shortName}</span>
          <span class="hidden lg:inline">{siteConfig.name}</span>
        </span>
        <span class:list={['mt-0.5 hidden text-xs font-semibold tracking-[0.05em] lg:block', taglineClass]}>
          {siteConfig.tagline}
        </span>
      </span>
    )
  }
</a>
