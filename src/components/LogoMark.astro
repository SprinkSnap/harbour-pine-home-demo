---
/**
 * Harbour & Pine Home mark: geometric pine over a harbour wave.
 * Tuned for small favicon sizes and large hero lockups.
 */
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'responsive';
  tone?: 'default' | 'on-dark';
}
const { class: className = '', size = 'md', tone = 'default' } = Astro.props;

const sizeClass =
  size === 'responsive'
    ? 'h-9 w-9 sm:h-11 sm:w-11'
    : size === 'sm'
      ? 'h-9 w-9'
      : size === 'lg'
        ? 'h-14 w-14'
        : 'h-11 w-11';

const radiusClass =
  size === 'responsive'
    ? 'rounded-[0.8rem] sm:rounded-[0.95rem]'
    : size === 'sm'
      ? 'rounded-[0.8rem]'
      : size === 'lg'
        ? 'rounded-[1.15rem]'
        : 'rounded-[0.95rem]';

const iconClass =
  size === 'responsive'
    ? 'h-[1.35rem] w-[1.35rem] sm:h-7 sm:w-7'
    : size === 'sm'
      ? 'h-[1.35rem] w-[1.35rem]'
      : size === 'lg'
        ? 'h-9 w-9'
        : 'h-7 w-7';

const surface =
  tone === 'on-dark'
    ? 'bg-sand text-pine-dark ring-1 ring-white/15'
    : 'bg-pine-dark text-sand ring-1 ring-pine-dark/10';
const accent = tone === 'on-dark' ? '#285B68' : '#E8DDCC';
const secondary = tone === 'on-dark' ? '#173B32' : '#9EAF9D';
---

<span
  class:list={[
    'grid shrink-0 place-items-center shadow-[var(--shadow-soft)] transition duration-[var(--duration-fast)] group-hover:scale-[1.03]',
    sizeClass,
    radiusClass,
    surface,
    className,
  ]}
  aria-hidden="true"
>
  <svg class={iconClass} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M16 4.2 23.4 13.8H20L24.8 20.2H20.8L25.6 26.2H6.4l4.8-6H7.2L12 13.8H8.6L16 4.2Z" fill="currentColor"></path>
    <path d="M14.8 26.2h2.4V28H14.8v-1.8Z" fill={secondary}></path>
    <path
      d="M6.8 29c2.4-1.5 4.2-1.5 6.6 0 2.4 1.5 4.2 1.5 6.6 0 2.4-1.5 4.2-1.5 6.6 0"
      stroke={accent}
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
</span>
