---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'responsive';
  tone?: 'default' | 'on-dark';
}
const { class: className = '', size = 'md', tone = 'default' } = Astro.props;

const sizeClass =
  size === 'responsive'
    ? 'h-9 w-9 sm:h-11 sm:w-11'
    : size === 'sm'
      ? 'h-9 w-9'
      : size === 'lg'
        ? 'h-14 w-14'
        : 'h-11 w-11';

const radiusClass =
  size === 'responsive'
    ? 'rounded-[0.75rem] sm:rounded-[0.9rem]'
    : size === 'sm'
      ? 'rounded-[0.75rem]'
      : size === 'lg'
        ? 'rounded-[1.1rem]'
        : 'rounded-[0.9rem]';

const iconClass =
  size === 'responsive'
    ? 'h-6 w-6 sm:h-7 sm:w-7'
    : size === 'sm'
      ? 'h-6 w-6'
      : size === 'lg'
        ? 'h-9 w-9'
        : 'h-7 w-7';

const surface = tone === 'on-dark' ? 'bg-sand text-pine-dark' : 'bg-pine-dark text-sand';
const accent = tone === 'on-dark' ? '#173B32' : '#E8DDCC';
---

<span
  class:list={['grid shrink-0 place-items-center shadow-[var(--shadow-soft)]', sizeClass, radiusClass, surface, className]}
  aria-hidden="true"
>
  <svg class={iconClass} viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M6 20.5V8.2c0-.7.5-1.2 1.2-1.2h4.3c2.7 0 4.4 1.5 4.4 3.8 0 1.7-1 3-2.6 3.5L17.8 21h-2.5l-4-6.3H8.5V21H6Zm2.5-8.5h3c1.3 0 2.1-.7 2.1-1.8S12.8 9.3 11.5 9.3h-3v2.7Z"
      fill="currentColor"
    ></path>
    <path
      d="M19.2 21c-2.5 0-4.1-1.6-4.1-4.1V8.8h2.4v7.8c0 1.3.7 2.1 2 2.1.5 0 .9-.1 1.2-.2l.4 2c-.5.3-1.2.5-1.9.5Z"
      fill={accent}
    ></path>
  </svg>
</span>
