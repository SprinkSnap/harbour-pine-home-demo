---
import { navPrimary } from '../data/site';
import Logo from './Logo.astro';
import HeaderControls from './react/HeaderControls';
---

<header class="sticky top-0 z-50 border-b border-sand/80 bg-porcelain/90 backdrop-blur-md">
  <div class="container-page flex min-h-14 items-center justify-between gap-2 py-2 sm:min-h-[4.5rem] sm:gap-4 sm:py-3">
    <Logo />
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        navPrimary.map((item) => (
          <a href={item.href} class="btn btn-ghost min-h-11 px-3 text-sm font-semibold text-pine-dark">
            {item.label}
          </a>
        ))
      }
    </nav>
    <HeaderControls client:load />
  </div>
</header>
