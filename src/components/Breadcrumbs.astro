---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-charcoal/75">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, index) => (
        <li class="inline-flex items-center gap-2">
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="hover:text-pine hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current={index === items.length - 1 ? 'page' : undefined} class={index === items.length - 1 ? 'font-semibold text-pine-dark' : ''}>
              {item.label}
            </span>
          )}
          {index < items.length - 1 ? <span aria-hidden="true">/</span> : null}
        </li>
      ))
    }
  </ol>
</nav>
