---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Shipping"
  description="Sample shipping policy architecture for the Harbour & Pine Home fictional portfolio store."
  path="/shipping/"
>
  <section class="section-space pt-8">
    <div class="container-page max-w-3xl">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shipping' }]} />
      <h1 class="mt-4 font-display text-4xl text-pine-dark">Shipping</h1>
      <p class="mt-4 rounded-md bg-sand/70 px-3 py-2 text-sm">
        Illustrative policy for a fictional portfolio store. A real merchant must provide and approve its own terms.
      </p>
      <div class="mt-6 space-y-4 text-charcoal/85">
        <p>Sample delivery estimates and rates shown in the demo cart are for interface demonstration only.</p>
        <p>A production store would publish verified shipping regions, carriers, cut-off times and exception handling.</p>
        <p>Do not treat sample shipping or availability details on this site as real merchant commitments.</p>
      </div>
    </div>
  </section>
</BaseLayout>
