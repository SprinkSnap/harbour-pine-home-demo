---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import ShopFilters from '../../components/react/ShopFilters';
import { getCollection } from '../../data/collections';
import { products } from '../../data/products';
import { breadcrumbJsonLd } from '../../lib/seo';
import { filterProducts, parseFilterParams } from '../../lib/product-filters';

const { slug } = Astro.params;
const collection = getCollection(slug!);
if (!collection) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const state = parseFilterParams(Astro.url.searchParams);
state.collection = collection.slug;
const collectionProducts = products.filter((product) => product.collection === collection.slug);
const result = filterProducts(products, state);
---

<BaseLayout
  title={collection.seoTitle}
  description={collection.seoDescription}
  path={`/collections/${collection.slug}/`}
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Collections', path: '/collections/' },
    { name: collection.name, path: `/collections/${collection.slug}/` },
  ])}
>
  <section class="section-space pt-8">
    <div class="container-page">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Collections', href: '/collections/' },
          { label: collection.name },
        ]}
      />
      <div class="mt-6 grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <h1 class="font-display text-4xl text-pine-dark">{collection.name}</h1>
          <p class="mt-3 max-w-2xl text-charcoal/80">{collection.longDescription}</p>
        </div>
        <img
          src={collection.image.src}
          alt={collection.image.alt}
          width={collection.image.width}
          height={collection.image.height}
          class="aspect-[4/3] w-full rounded-[var(--radius-xl)] object-cover"
          fetchpriority="high"
        />
      </div>
      <div class="mt-8 grid gap-8 lg:grid-cols-[280px_1fr]">
        <ShopFilters
          client:load
          products={collectionProducts}
          lockedCollection={collection.slug}
          resultCount={result.total}
        />
        <div>
          {
            result.items.length === 0 ? (
              <div class="surface rounded-[var(--radius-xl)] p-6" role="status">
                <h2 class="font-display text-2xl text-pine-dark">No products found</h2>
                <p class="mt-2 text-charcoal/80">Try clearing filters for this collection.</p>
              </div>
            ) : (
              <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                {result.items.map((product) => <ProductCard product={product} />)}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
