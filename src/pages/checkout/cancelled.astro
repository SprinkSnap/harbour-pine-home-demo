---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Checkout Cancelled"
  description="The Harbour & Pine checkout demonstration was cancelled. No order or payment was created."
  path="/checkout/cancelled/"
>
  <section class="section-space pt-8">
    <div class="container-page max-w-2xl">
      <div class="surface rounded-[var(--radius-xl)] p-8">
        <h1 class="font-display text-4xl text-pine-dark">Checkout demonstration cancelled</h1>
        <p class="mt-4 text-charcoal/80">
          No order, shipment or payment was created. You can return to the cart or continue browsing the fictional catalogue.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/cart/" class="btn btn-primary">Return to cart</a>
          <a href="/shop/" class="btn btn-secondary">Continue shopping</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
