---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getJournalPost, journalPosts } from '../../data/journal';

export function getStaticPaths() {
  return journalPosts.map((post) => ({ params: { slug: post.slug } }));
}

const post = getJournalPost(Astro.params.slug!);
if (!post) return Astro.redirect('/404/');
---

<BaseLayout title={post.title} description={post.excerpt} path={`/journal/${post.slug}/`}>
  <article class="section-space pt-8">
    <div class="container-page max-w-3xl">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Journal', href: '/journal/' },
          { label: post.title },
        ]}
      />
      <p class="mt-4 text-sm font-semibold uppercase tracking-[0.08em] text-harbour">
        {post.publishedAt} · {post.readingMinutes} min read
      </p>
      <h1 class="mt-3 font-display text-4xl text-pine-dark">{post.title}</h1>
      <div class="mt-6 space-y-4 text-charcoal/85">
        {post.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a href="/journal/" class="btn btn-secondary mt-8">Back to journal</a>
    </div>
  </article>
</BaseLayout>
