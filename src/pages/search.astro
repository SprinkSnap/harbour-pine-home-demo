---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ShopFilters from '../components/react/ShopFilters';
import { products } from '../data/products';
import { breadcrumbJsonLd } from '../lib/seo';
import { filterProducts, parseFilterParams } from '../lib/product-filters';

const state = parseFilterParams(Astro.url.searchParams);
const result = filterProducts(products, state);
const pageTitle = state.q ? `Search results for “${state.q}”` : 'Search';
---

<BaseLayout
  title={pageTitle}
  description="Search the Harbour & Pine Home demonstration catalogue by product, material, colour or room."
  path="/search/"
  noindex={true}
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Search', path: '/search/' },
  ])}
>
  <section class="section-space pt-8">
    <div class="container-page">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Search' }]} />
      <h1 class="mt-4 font-display text-3xl text-pine-dark sm:text-4xl">Search</h1>
      <p class="mt-3 max-w-2xl text-charcoal/80">Find products quickly with shareable filter URLs.</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-[280px_1fr] lg:gap-8">
        <ShopFilters client:load products={products} resultCount={result.total} initialQuery={state.q} />
        <div>
          <p class="mb-4 text-sm text-charcoal/75" aria-live="polite">
            {result.total} result{result.total === 1 ? '' : 's'}
            {state.q ? ` for “${state.q}”` : ''}
          </p>
          {
            result.items.length === 0 ? (
              <div class="surface rounded-[var(--radius-xl)] p-6" role="status">
                <h2 class="font-display text-2xl text-pine-dark">No matches</h2>
                <p class="mt-2 text-charcoal/80">Try a broader term like “tray”, “linen” or “desk”.</p>
              </div>
            ) : (
              <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                {result.items.map((product) => <ProductCard product={product} />)}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
